# Copy to .env in this folder (material-function/).
# Loaded by render_rmd.R before rmarkdown::render().

# When R is started from a GUI, PATH often omits Homebrew. Prepend brew bin here.
PATH_PREPEND=/opt/homebrew/bin

# Optional: directory containing pandoc (rmarkdown honors this like RStudio)
# RSTUDIO_PANDOC=/opt/homebrew/bin
