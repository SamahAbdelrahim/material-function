.Rproj.user/
**/.Rhistory
**/.RData

# Environment and credentials
.env

# macOS system files
**/.DS_Store

# Identified spreadsheets (never commit): regenerate public tables with scripts/anonymize_data.py
data_identified/

# Optional scratch outputs (legacy CLI that wrote sibling *-anon.csv files)
data/*-anon.csv

# Compiled outputs — regenerated on knit, not source-of-truth
Manuscript/MS.pdf
Manuscript/figs/
summer2025/*.pdf

# Private working documents: AI collaboration logs, brainstorming, interpretation notes, presentations
MEMORY.md
Manuscript/interpret/
Manuscript/theoretical-skeleton.md

# Archive — old drafts, exploratory code, AI session logs, large video files
# Nothing here is currently tracked; gitignoring the whole folder keeps it local-only
archive/

# Node.js dependencies
**/node_modules/

# Python
scripts/__pycache__/
